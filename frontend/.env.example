# Copy to `.env` and set the backend base URL.
# One variable per line — never `VITE_API_URL=VITE_API_BASE_URL=...` on a single line.
#
# Host only or host + /api, both work (the app normalises it):
VITE_API_URL=https://vvs-backend-pi.vercel.app/api
#
# Local development (see .env.development): leave it as the proxy path
# VITE_API_URL=/api
